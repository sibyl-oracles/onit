# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# Environment variables
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Session artifacts
tmp/
.onit/
serve_registry.json
serve_logs/

# Eval
*.eval

# The ruler: a locally drawn holdout is a local artifact, not source.  The
# split that ships is the one the repository pins deliberately, and a
# holdout drawn on one machine from one machine's corpus would be
# meaningless on another.
benchmarks/eval/holdout.jsonl
benchmarks/eval/dev.jsonl
benchmarks/eval/split.json
benchmarks/eval/baseline.json

# Local search index artifacts
local_search/
# Scratch commit-message file, written while committing.
tmp_commit_msg.txt

# Local scratch / debug output
data/

# Model weights — large local artifacts, never source.  The Kokoro TTS
# weights (kokoro-v1.0.onnx, voices-v1.0.bin) download on first use to
# ~/.onit/models/kokoro and must never be committed.  A legitimate binary
# fixture added later needs an explicit ! negation here.
*.onnx
*.bin

# SwiftPM / Xcode build output
.build/
